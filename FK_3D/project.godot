; Engine configuration file.
config_version=5

[application]

config/name="FrettchenKolonie"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/version="16.12"

[autoload]

GraphicsSettings="*res://autoloads/GraphicsSettings.gd"
GameState="*res://autoloads/GameState.gd"
BuildingData="*res://systems/BuildingData.gd"
ResourceSys="*res://systems/ResourceSystem.gd"
BuildingSys="*res://systems/BuildingSystem.gd"
PopMgr="*res://systems/PopulationManager.gd"
DayNight="*res://systems/DayNightSystem.gd"
TechTreeSys="*res://systems/TechTree.gd"
DroughtSys="*res://systems/DroughtSystem.gd"
WaterSys="*res://systems/WaterSystem.gd"
SeasonSys="*res://systems/SeasonSystem.gd"
ExpeditionSys="*res://systems/ExpeditionSystem.gd"
SaveSys="*res://systems/SaveSystem.gd"
SoundSys="*res://systems/SoundSystem.gd"
AchievementSys="*res://systems/AchievementSystem.gd"
PlayerAccessories="*res://systems/PlayerAccessories.gd"
DevMode="*res://autoloads/DevMode.gd"
DistrictSys="*res://systems/DistrictSystem.gd"
ColonySys="*res://systems/ColonySystem.gd"
RailSys="*res://systems/RailSystem.gd"
ExploreSys="*res://systems/ExploreSystem.gd"
NeighborSys="*res://systems/NeighborSystem.gd"
FarmSys="*res://systems/FarmFieldSystem.gd"
TouchControlsSettings="*res://autoloads/TouchControlsSettings.gd"
MenuManager="*res://autoloads/MenuManager.gd"
UISounds="*res://autoloads/UISounds.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
; v16.12: "expand" statt Godot-Default "keep" - BEHEBT den Fix-16:9-Bug:
; Fenster können beliebig gezogen/verzerrt werden, die UI (ankerbasiert)
; passt sich der tatsächlichen Fensterform an, keine schwarzen Balken mehr.
window/stretch/aspect="expand"

