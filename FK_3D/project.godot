[layer_names]

3d_physics/layer_1="Terrain"
3d_physics/layer_2="Buildings"

; Fix (v14.5, Godot-Versions-Update, Verdacht auf Absturzursache): explizit
; auf GodotPhysics3D gepinnt. Ab Godot 4.7 ist laut Engine-Dokumentation
; Jolt Physics die neue Standard-3D-Physik-Engine (vorher: GodotPhysics3D).
; Ohne diese explizite Einstellung würde das Projekt beim Öffnen mit einem
; neu installierten Godot 4.7 automatisch auf Jolt umgestellt - obwohl die
; komplette Terrain-Kollision (Trimesh + pro-Tile-Box-Shapes, siehe
; WorldRenderer3D._build_collision()) und die Charakterbewegung nur je gegen
; GodotPhysics3D getestet/abgestimmt wurden. Ein stiller Engine-Wechsel beim
; Godot-Update ist ein sehr plausibler Kandidat für neue Abstürze/Glitches,
; die genau jetzt (nach einem Godot-Versionswechsel) auftreten.
[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="forward_plus"

[debug]

; GameState.gd ist bewusst ein zentraler Signal-Hub: alle Signale werden in
; anderen Skripten (.emit()/.connect()) verwendet, aber nie innerhalb von
; GameState.gd selbst - das loest die (harmlose) "signal nie verwendet"
; Warnung fuer jedes einzelne Signal aus. Hier bewusst global stummgeschaltet,
; da es sich um Code-Stil-Rauschen handelt, keinen echten Fehler.
gdscript/warnings/unused_signal=0

[editor]

; Fix v15.12: Godot 4.7 crasht beim parallelen Reimport vieler Dateien.
; Da die Release-ZIPs keinen .godot-Ordner enthalten, muss Godot bei jedem
; frischen Entpacken alles neu importieren - single-threaded als Workaround.
import/use_multiple_threads=false
